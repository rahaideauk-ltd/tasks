APP_NAME="Growth Tasks"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tasks.example.com

# UI language: fa or en (users can switch with ?lang=)
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# ---- MySQL ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=growth_tasks
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database

# sync = analysis runs right after the HTTP response (no worker needed).
# database = run `php artisan queue:work` for background analysis.
QUEUE_CONNECTION=sync

# ---- Growth Tasks ----
# true: generated tasks go straight to the client. false: admin reviews drafts and publishes rounds.
TASKS_AUTO_PUBLISH=false

# Google OAuth (Search Console + GA4). Redirect URI: {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude (AI task generation). Without it only the rule engine runs.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
